#!/bin/bash

# Script to run the Creator-Ops development server

echo "Starting Creator-Ops development server..."

# Navigate to the creator-ops directory
cd "$(dirname "$0")/creator-ops"

# Check if node_modules exists, if not install dependencies
if [ ! -d "node_modules" ]; then
  echo "Installing dependencies first..."
  npm install
fi

# Start the development server
echo "Starting the development server..."
npm run dev

# The server will start and display the local URL to access your app